<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- ApoMicFeed writes straight into the shared ring. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- The sound editor: voice isolation runs a separation model on the CPU; Ogg export. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundBoardKing.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundBoardKing.Core\SoundBoardKing.Core.csproj" />
  </ItemGroup>

</Project>
