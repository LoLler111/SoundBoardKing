<Window x:Class="SoundBoardKing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SoundBoardKing.App.ViewModels"
        xmlns:conv="clr-namespace:SoundBoardKing.App.Converters"
        xmlns:ctl="clr-namespace:SoundBoardKing.App.Controls"
        Title="SoundBoardKing" Icon="Assets/SoundBoardKing.ico" Width="1240" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:IntEqualsConverter x:Key="IntEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Margin="0,0,24,0">
                    <Run Text="SoundBoard" /><Run Text="King" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>

                <Button DockPanel.Dock="Left" Margin="0,0,8,0" Command="{Binding ImportSplCommand}"
                        ToolTip="Importa suoni, categorie e preferiti da un file .spl di SoundPad">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B5;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Importa da SoundPad" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding AddFilesCommand}"
                        ToolTip="Aggiungi file audio (puoi anche trascinarli nella finestra)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Aggiungi suoni" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Impostazioni" Margin="4,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8EA;"
                        Click="PhoneButton_Click" ToolTip="Telefono" Margin="8,0,0,0" />

                <Grid DockPanel.Dock="Right" Width="300">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <TextBlock Text="Cerca suoni… (Ctrl+F)" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border />
            </DockPanel>
        </Border>

        <!-- Categories | sounds -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                                Command="{Binding NewCategoryCommand}" ToolTip="Nuova categoria" />
                        <TextBlock Text="CATEGORIE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </DockPanel>

                    <TreeView x:Name="CategoryTree" ItemsSource="{Binding CategoryRoots}" Margin="6,0,6,6"
                              PreviewMouseRightButtonDown="CategoryTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="AllowDrop" Value="True" />
                                <EventSetter Event="DragOver" Handler="CategoryItem_DragOver" />
                                <EventSetter Event="Drop" Handler="CategoryItem_Drop" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNodeViewModel}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" Padding="2,1" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nuova categoria" Command="{Binding NewCategoryCommand}" />
                                <MenuItem Header="Nuova sottocategoria" Command="{Binding NewSubcategoryCommand}" />
                                <MenuItem Header="Rinomina…" Command="{Binding RenameCategoryCommand}" />
                                <Separator />
                                <MenuItem Header="Elimina" Command="{Binding DeleteCategoryCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BgBrush}" />

            <DataGrid x:Name="SoundGrid" Grid.Column="2"
                      ItemsSource="{Binding VisibleSounds}" SelectedItem="{Binding SelectedSound}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="SoundGrid_MouseDoubleClick" PreviewKeyDown="SoundGrid_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="SoundGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SoundGrid_PreviewMouseMove">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="ToolTip" Value="{Binding Model.Path}" />
                                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="11"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="170" />
                    <DataGridTextColumn Header="Durata" Binding="{Binding Duration}" SortMemberPath="Model.DurationMs" Width="80" />
                    <DataGridTextColumn Header="Tasto rapido" Binding="{Binding Hotkey}" Width="130" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Riproduci" Command="{Binding PlaySoundCommand}" InputGestureText="Invio" FontWeight="SemiBold" />
                        <MenuItem Header="Anteprima (solo in cuffia)" Command="{Binding PreviewSoundCommand}" />
                        <MenuItem Header="Solo nel microfono" Command="{Binding PlaySoundOnMicCommand}" />
                        <Separator />
                        <MenuItem Header="Aggiungi ai preferiti" Command="{Binding AddToHotbarCommand}" />
                        <MenuItem Header="Tasto rapido…" Command="{Binding AssignHotkeyCommand}" />
                        <MenuItem Header="Rinomina…" Command="{Binding RenameSoundCommand}" InputGestureText="F2" />
                        <MenuItem Header="Mostra il file in Esplora risorse" Command="{Binding OpenFileLocationCommand}" />
                        <Separator />
                        <MenuItem Header="Togli dalla categoria" Command="{Binding RemoveFromCategoryCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Rimuovi dalla libreria" Command="{Binding RemoveSoundsCommand}" InputGestureText="Canc"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>

        <!-- Hotbar (favourites) -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,8,12,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                    <TextBlock Text="PREFERITI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,0,14,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE76B;" Command="{Binding PreviousHotbarPageCommand}"
                                ToolTip="Pagina precedente" Margin="0,0,4,0" />
                        <RadioButton Style="{StaticResource PageRadio}" Content="1" IsChecked="{Binding HotbarPage, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource PageRadio}" Content="2" IsChecked="{Binding HotbarPage, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource PageRadio}" Content="3" IsChecked="{Binding HotbarPage, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
                        <RadioButton Style="{StaticResource PageRadio}" Content="4" IsChecked="{Binding HotbarPage, Converter={StaticResource IntEquals}, ConverterParameter=3}" />
                        <RadioButton Style="{StaticResource PageRadio}" Content="5" IsChecked="{Binding HotbarPage, Converter={StaticResource IntEquals}, ConverterParameter=4}" />
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE76C;" Command="{Binding NextHotbarPageCommand}"
                                ToolTip="Pagina successiva" />
                    </StackPanel>
                    <TextBlock Text="Trascina un suono su uno slot per assegnarlo" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                </DockPanel>

                <!-- Two rows in view, the rest by scrolling (also while dragging a sound near the edges). -->
                <ScrollViewer x:Name="HotbarScroll" MaxHeight="128" VerticalScrollBarVisibility="Auto"
                              PreviewDragOver="HotbarScroll_PreviewDragOver">
                <ItemsControl ItemsSource="{Binding HotbarSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HotbarSlotViewModel}">
                            <Button x:Name="SlotButton" Style="{StaticResource HotbarButton}" Margin="3" Height="58"
                                    Command="{Binding DataContext.PlayHotbarSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Sound.Title}"
                                    AllowDrop="True" DragOver="HotbarSlot_DragOver" Drop="HotbarSlot_Drop">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Riproduci" Click="PlayHotbarSlot_Click" FontWeight="SemiBold" />
                                        <MenuItem Header="Anteprima (solo in cuffia)" Click="PreviewHotbarSlot_Click" />
                                        <MenuItem Header="Solo nel microfono" Click="PlayHotbarSlotOnMic_Click" />
                                        <Separator />
                                        <MenuItem Header="Svuota slot" Click="ClearHotbarSlot_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <TextBlock Text="{Binding Number}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Sound.Title}" FontSize="12" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                               VerticalAlignment="Center" Margin="4,8,4,0" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter TargetName="SlotButton" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Sound.IsPlaying}" Value="True">
                                    <Setter TargetName="SlotButton" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="SlotButton" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Now playing -->
        <Border Grid.Row="3" Background="{StaticResource BgBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding TogglePauseCommand}" ToolTip="Pausa / riprendi">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE768;" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlaying}" Value="True" />
                                            <Condition Binding="{Binding IsPaused}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Content" Value="&#xE769;" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="Ferma tutto" />
                </StackPanel>

                <!-- One bar per sound playing, side by side; each disappears when its sound ends or is stopped. -->
                <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Nessun suono in riproduzione" FontWeight="SemiBold" />
                        <ProgressBar Margin="0,6,0,0" Value="0" />
                    </StackPanel>
                    <ItemsControl x:Name="NowPlayingList" ItemsSource="{Binding NowPlaying}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" Foreground="{StaticResource TextDimBrush}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Margin="0,4,0,0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.PauseOneCommand, ElementName=NowPlayingList}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                                                <Setter Property="Content" Value="&#xE769;" />
                                                <Setter Property="ToolTip" Value="Metti in pausa questo suono" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Content" Value="&#xE768;" />
                                                        <Setter Property="ToolTip" Value="Riprendi questo suono" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="2,0,0,0"
                                            VerticalAlignment="Center" ToolTip="Ferma questo suono"
                                            Command="{Binding DataContext.StopOneCommand, ElementName=NowPlayingList}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Volume in cuffia, with the spectrum of what the speakers are playing behind it. -->
                    <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="10,0" Height="38"
                            ToolTip="Volume in cuffia (sotto: lo spettro di ciò che senti)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Grid Width="170">
                                <ctl:SpectrumMeter Reader="{Binding SpeakerSpectrum}" Fill="{StaticResource AccentBrush}"
                                                   Opacity="0.6" Margin="0,4" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding SpeakerVolume}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SpeakerVolume, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- Voice effect for the sounds: a click opens the list. -->
                    <Button x:Name="EffectButton" Margin="12,0,0,0" Cursor="Hand" Click="EffectButton_Click"
                            ToolTip="Effetto sulla voce dei suoni che fai partire (nelle cuffie e nel microfono)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="10,5">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding EffectOptions}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="IsCheckable" Value="False" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding DataContext.SetSoundEffectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SoundEffectLabel}" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>
                    <!-- Where the effect goes: sounds only, voice only, both or none, picked from a list. -->
                    <Button x:Name="EffectTargetButton" Margin="6,0,0,0" Cursor="Hand" Click="EffectTargetButton_Click"
                            ToolTip="A cosa si applica l'effetto: solo suoni, solo microfono (la tua voce), entrambi, nessuno">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="8,5">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding EffectTargetOptions}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="IsCheckable" Value="False" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding DataContext.SetEffectTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EffectTargetLabel}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>
                    <!-- How strong the effect is; turning it changes the sounds already playing too. -->
                    <ctl:Knob Width="30" Height="30" Margin="8,0,0,0" Minimum="0" Maximum="100" DefaultValue="70"
                              Value="{Binding EffectAmount}" IsEnabled="{Binding HasEffect}"
                              Fill="{StaticResource AccentBrush}" Track="{StaticResource TrackBrush}" Foreground="{StaticResource TextBrush}"
                              ToolTip="{Binding EffectAmountPercent}" ToolTipService.InitialShowDelay="0" />
                    <TextBlock Text="{Binding EffectAmountPercent, StringFormat={}{0}%}" Width="34" Margin="4,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                    <!-- Effect pad: across = strength, up and down = speed of the sounds, like a record. -->
                    <ToggleButton x:Name="PadToggle" Margin="4,0,0,0" Cursor="Hand"
                                  ToolTip="Pad degli effetti: orizzontale = intensità, verticale = velocità">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="8,5">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80A;" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SpeedText}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=PadToggle}" PlacementTarget="{Binding ElementName=PadToggle}"
                           Placement="Top" VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True"
                           Closed="PadPopup_Closed">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetPadCommand}" Padding="10,3"
                                            ToolTip="Velocità normale e intensità predefinita" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextDimBrush}">
                                        <Run Text="{Binding SoundEffectLabel, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding EffectAmountPercent, Mode=OneWay, StringFormat={}{0}%}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <Grid>
                                    <ctl:XYPad Width="280" Height="180" X="{Binding EffectAmount}" Y="{Binding PadSpeed}"
                                               Background="{StaticResource Panel2Brush}" Line="{StaticResource LineBrush}"
                                               Fill="{StaticResource AccentBrush}" />
                                    <TextBlock Text="intensità →" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" IsHitTestVisible="False" />
                                    <TextBlock Text="↑ più veloce" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0" IsHitTestVisible="False" />
                                    <TextBlock Text="↓ più lento" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,4" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton IsChecked="{Binding PlayOnMic}" Margin="8,0,8,0" Cursor="Hand"
                                  ToolTip="Invia i suoni anche nel microfono (clic per accendere/spegnere). Il modulo si installa dalle impostazioni.">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="10,5">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMicActive}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE720;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MicStatusText}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Volume nel microfono, with the spectrum of only what is sent into the microphone. -->
                    <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="10,0" Height="38"
                            ToolTip="Volume nel microfono (sotto: lo spettro di ciò che arriva nel microfono)">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="130" IsEnabled="{Binding PlayOnMic}">
                                <ctl:SpectrumMeter Reader="{Binding MicSpectrum}" Fill="{StaticResource MicBrush}"
                                                   Opacity="0.6" Margin="0,4" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding MicVolume}" VerticalAlignment="Center"
                                        Foreground="{StaticResource MicBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding MicVolume, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="14,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LibrarySummary}" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
                <Button DockPanel.Dock="Right" Command="{Binding RestartToUpdateCommand}" Margin="0,0,16,0" Padding="8,1"
                        FontSize="12" Style="{StaticResource AccentButton}"
                        Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="La nuova versione è già scaricata: si installa da sola quando chiudi SoundBoardKing, oppure subito con questo pulsante.">
                    <TextBlock Text="{Binding UpdateReadyVersion, StringFormat=Aggiorna alla {0}}" />
                </Button>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
