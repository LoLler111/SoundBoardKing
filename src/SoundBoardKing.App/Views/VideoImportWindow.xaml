<Window x:Class="SoundBoardKing.App.Views.VideoImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundBoardKing.App.Controls"
        Title="Suono da un video" Width="1040" Height="800" MinWidth="760" MinHeight="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" AllowDrop="True"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Margin" Value="6,0,14,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14,16,16">
        <!-- Source: a link or a file -->
        <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="LinkBox" Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadLinkCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Incolla il link di un video: YouTube, TikTok, Instagram, Facebook e molti altri siti" Margin="11,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=LinkBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Command="{Binding LoadLinkCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                    ToolTip="Scarica il video del link (Invio)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Scarica" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding OpenFileCommand}" Margin="8,0,0,0"
                    ToolTip="Apri un video dal PC (puoi anche trascinarlo nella finestra)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Apri file…" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                        ToolTip="Alcuni video di Instagram e Facebook (e quelli vietati ai minori su YouTube) si vedono solo dopo l'accesso: scegli il browser in cui sei collegato e yt-dlp userà quell'accesso, solo per scaricare dal sito del video. Chrome va chiuso del tutto, altrimenti non si lascia leggere.">
                <TextBlock Text="Accesso dal browser" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding CookieBrowsers}" SelectedItem="{Binding SelectedCookieBrowser}" DisplayMemberPath="Label" Width="100" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SourceTitle}" FontSize="15" FontWeight="SemiBold" Margin="2,12,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceTitle}"
                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

        <!-- Save -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" IsEnabled="{Binding IsReady}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Nome del suono" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" Width="190" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Formato" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" Width="112" />
                    <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" ItemStringFormat="{}{0} kbps" Width="92" Margin="6,0,0,0"
                              Visibility="{Binding IsLossy, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Più è alta, più il suono è fedele e il file grande. 192 kbps va bene quasi sempre." />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Aggiungi e modifica…" Command="{Binding AddAndEditCommand}"
                        ToolTip="Aggiunge il pezzo scelto e lo apre nell'editor: dissolvenze, volume, isola voce…" />
                <Button Command="{Binding AddCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        ToolTip="Salva il pezzo selezionato come suono e lo aggiunge alla libreria. La finestra resta aperta per prenderne altri.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Aggiungi alla soundboard" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="2,10,0,0" ToolTip="{Binding StatusText}" />

        <!-- Video, transport and waveform; the busy panel covers them all -->
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Border Background="Black" CornerRadius="6" ClipToBounds="True" MouseLeftButtonDown="Video_MouseLeftButtonDown">
                <Grid>
                    <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" IsMuted="True"
                                  Stretch="Uniform" MediaOpened="Video_MediaOpened" MediaFailed="Video_MediaFailed" />
                    <!-- Nothing open yet -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSource}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE714;" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Il video serve solo a vedere dove sei: alla fine diventa un suono." HorizontalAlignment="Center"
                                   FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="Incolla un link qui sopra, apri un file, oppure trascina qui un video o un link dal browser."
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                    <!-- Audio only -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSource}" Value="True" />
                                            <Condition Binding="{Binding HasVideo}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="Nessuna immagine: scegli il pezzo dalla forma d'onda." Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transport and selection -->
            <DockPanel Grid.Row="1" Margin="0,10,0,8" IsEnabled="{Binding IsReady}">
                <Button DockPanel.Dock="Left" Command="{Binding PlayPauseCommand}" MinWidth="104" Margin="0,0,12,0"
                        ToolTip="Ascolta in cuffia la selezione, o dal cursore alla fine; il video va insieme (Spazio)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ascolta" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                            <Setter Property="Text" Value="Ferma" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Width="96" Margin="0,0,10,0" ToolTip="Volume dell'ascolto in cuffia">
                        <TextBlock Text="{Binding PreviewVolume, StringFormat=Volume {0:0}%}" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding PreviewVolume}" />
                    </StackPanel>
                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Allontana (Ctrl+rotella)" />
                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Avvicina (Ctrl+rotella)" />
                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE8B3;" Click="ZoomSelection_Click" ToolTip="Ingrandisci la selezione" />
                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE9A6;" Click="ZoomFit_Click" ToolTip="Mostra tutto" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Inizio" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionStartText}" KeyDown="TimeBox_KeyDown"
                                 ToolTip="Dove inizia il pezzo: minuti:secondi, oppure solo i secondi" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Fine" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionEndText}" KeyDown="TimeBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Durata" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionLengthText}" KeyDown="TimeBox_KeyDown" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}">
                        <Run Text="Video:" /> <Run Text="{Binding DurationText, Mode=OneWay}" />
                    </TextBlock>
                </WrapPanel>
            </DockPanel>

            <!-- Waveform -->
            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" IsEnabled="{Binding IsReady}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:WaveformView x:Name="Wave" Audio="{Binding Clip}"
                                           SelectionStart="{Binding SelectionStart}" SelectionEnd="{Binding SelectionEnd}"
                                           Playhead="{Binding Playhead}" />
                    <ScrollBar x:Name="WaveScroll" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed" Scroll="WaveScroll_Scroll" />
                </Grid>
            </Border>

            <!-- Busy -->
            <Border Grid.RowSpan="3" Background="#D017171B" CornerRadius="6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                    <TextBlock HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,10">
                        <Run Text="{Binding BusyText, Mode=OneWay}" />
                        <Run Foreground="{StaticResource TextDimBrush}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text" Value="{Binding BusyProgress, Mode=OneWay, StringFormat={}{0:0}%}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusyIndeterminate}" Value="True">
                                            <Setter Property="Text" Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                    <ProgressBar Height="6" Maximum="100" Value="{Binding BusyProgress}" IsIndeterminate="{Binding IsBusyIndeterminate}" />
                    <Button Content="Annulla" Command="{Binding CancelBusyCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
