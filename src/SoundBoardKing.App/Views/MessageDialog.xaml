<Window x:Class="SoundBoardKing.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- The margin leaves room for the shadow around the rounded panel. -->
    <Border Margin="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="22,20,22,18" MinWidth="340" MaxWidth="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse x:Name="IconBack" Opacity="0.16" />
                    <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="48,10,0,0" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="19" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="NoButton" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="No_Click" />
                <Button x:Name="YesButton" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Yes_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
