<Window x:Class="SoundBoardKing.App.Views.RvcVoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,0,0,14"
                   Text="Un modello RVC trasforma una voce in un'altra: la voce di base legge il testo, il modello la fa diventare la sua. Scegli il file .pth (o lo .zip che lo contiene): l'indice .index accanto viene trovato da solo." />

        <TextBlock Text="Modello" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="BrowseModel_Click" Margin="8,0,0,0" />
            <TextBox Text="{Binding ModelPath, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>
        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
            <Run Text="Indice:" />
            <Run Text="{Binding IndexPath, Mode=OneWay, TargetNullValue='nessuno (la voce somiglierà meno al modello)'}" />
        </TextBlock>
        <Button HorizontalAlignment="Left" Content="Scegli un altro indice…" Click="BrowseIndex_Click" Margin="0,4,0,0" Padding="8,2" FontSize="12" />

        <TextBlock Text="Nome" Margin="0,14,0,4" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Voce che legge il testo" Margin="0,14,0,4" />
        <ComboBox ItemsSource="{Binding BaseVoices}" SelectedItem="{Binding BaseVoice}" />
        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                   Text="Meglio una voce dello stesso sesso del modello e con un ritmo calmo: per esempio Nicola (Kokoro)." />

        <TextBlock Text="Tono" Margin="0,14,0,4" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PitchText}" Width="150" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
            <Slider Minimum="-12" Maximum="12" Value="{Binding Pitch}" IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center" ToolTip="Semitoni in più o in meno rispetto alla voce di base" />
        </DockPanel>

        <TextBlock Text="Intonazione" Margin="0,14,0,4" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding IntonationText}" Width="150" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
            <Slider Minimum="0" Maximum="200" Value="{Binding IntonationPercent}" IsSnapToTickEnabled="True" TickFrequency="10"
                    VerticalAlignment="Center"
                    ToolTip="Quanto sale e scende la voce: sotto il 100% più piatta e monotona, sopra più mossa ed espressiva" />
        </DockPanel>

        <TextBlock Text="Somiglianza al modello (indice)" Margin="0,14,0,4" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding IndexText}" Width="150" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding IndexPercent}" IsSnapToTickEnabled="True" TickFrequency="5"
                    VerticalAlignment="Center"
                    ToolTip="Più alto: più simile alla voce del modello, ma meno pulita. RVC usa di solito il 66%" />
        </DockPanel>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="Controllo il modello…" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextDimBrush}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Salva" Style="{StaticResource AccentButton}" MinWidth="90" Click="Save_Click" IsDefault="True" />
            <Button Content="Annulla" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
