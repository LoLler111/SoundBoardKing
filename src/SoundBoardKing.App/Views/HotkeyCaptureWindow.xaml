<Window x:Class="SoundBoardKing.App.Views.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasto rapido" Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Premi la combinazione di tasti, ad esempio Ctrl+Alt+1. Esc per annullare."
                   Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
        <Border Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="12">
            <TextBlock x:Name="GestureText" Text="—" FontSize="20" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Rimuovi" Focusable="False" Margin="0,0,8,0" MinWidth="90" Click="Clear_Click" />
            <Button Content="Annulla" Focusable="False" Margin="0,0,8,0" MinWidth="90" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="OK" Focusable="False" Style="{StaticResource AccentButton}" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
