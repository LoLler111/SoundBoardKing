<Window x:Class="SoundBoardKing.App.Views.SoundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundBoardKing.App.Controls"
        Title="{Binding Title}" Width="1080" Height="660" MinWidth="780" MinHeight="460" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Toolbar buttons: an icon over a short label. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Margin" Value="4,0,0,4" />
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Margin" Value="6,0,14,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14,16,16">
        <!-- Tools -->
        <WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding IsReady}">
            <Border Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Text="Ascolto" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding PlayPauseCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Ascolta in cuffia la selezione, o dal cursore alla fine (Spazio)">
                            <StackPanel>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ToolIcon}">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ToolLabel}">
                                            <Setter Property="Text" Value="Ascolta" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                    <Setter Property="Text" Value="Ferma" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Width="96" Margin="4,0,4,0" ToolTip="Volume dell'ascolto in cuffia">
                            <TextBlock Text="{Binding PreviewVolume, StringFormat=Volume {0:0}%}" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding PreviewVolume}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Text="Modifica" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding UndoCommand}" Style="{StaticResource ToolButton}" ToolTip="Annulla (Ctrl+Z)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A7;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Annulla" /></StackPanel>
                        </Button>
                        <Button Command="{Binding RedoCommand}" Style="{StaticResource ToolButton}" ToolTip="Ripeti (Ctrl+Y)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A6;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Ripeti" /></StackPanel>
                        </Button>
                        <Button Command="{Binding CutCommand}" Style="{StaticResource ToolButton}" ToolTip="Taglia la selezione (Ctrl+X)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8C6;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Taglia" /></StackPanel>
                        </Button>
                        <Button Command="{Binding CopyCommand}" Style="{StaticResource ToolButton}" ToolTip="Copia la selezione (Ctrl+C)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8C8;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Copia" /></StackPanel>
                        </Button>
                        <Button Command="{Binding PasteCommand}" Style="{StaticResource ToolButton}" ToolTip="Incolla nel punto del cursore, o al posto della selezione (Ctrl+V)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE77F;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Incolla" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Text="Durata" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding KeepSelectionCommand}" Style="{StaticResource ToolButton}" ToolTip="Tieni solo la parte selezionata: il resto, prima e dopo, sparisce">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A8;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Ritaglia" /></StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectionCommand}" Style="{StaticResource ToolButton}" ToolTip="Elimina la parte selezionata (Canc)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Elimina" /></StackPanel>
                        </Button>
                        <Button Command="{Binding SilenceSelectionCommand}" Style="{StaticResource ToolButton}" ToolTip="Rendi silenziosa la parte selezionata, senza accorciare il suono">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74F;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Silenzio" /></StackPanel>
                        </Button>
                        <Button Command="{Binding InsertSilenceCommand}" Style="{StaticResource ToolButton}" ToolTip="Aggiungi una pausa nel punto del cursore">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Pausa…" /></StackPanel>
                        </Button>
                        <Button Command="{Binding InsertFileCommand}" Style="{StaticResource ToolButton}" ToolTip="Aggiungi un altro file audio nel punto del cursore (o al posto della selezione)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Aggiungi file…" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Text="Sfumature e volume" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding FadeInCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Dissolvenza in entrata: sulla selezione, o dall'inizio fino al cursore">
                            <StackPanel>
                                <Path Data="M0,14 L22,0 L22,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      HorizontalAlignment="Center" Margin="0,1,0,4" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Entrata" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FadeOutCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Dissolvenza in uscita: sulla selezione, o dal cursore fino alla fine">
                            <StackPanel>
                                <Path Data="M0,0 L22,14 L0,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      HorizontalAlignment="Center" Margin="0,1,0,4" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Uscita" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="2,0,10,0" ToolTip="Come cambia il volume durante la dissolvenza">
                            <TextBlock Text="Curva" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            <ComboBox ItemsSource="{Binding FadeCurves}" SelectedItem="{Binding SelectedCurve}" DisplayMemberPath="Label" Width="150" />
                        </StackPanel>
                        <Button Command="{Binding AmplifyCommand}" Style="{StaticResource ToolButton}" ToolTip="Alza o abbassa il volume della selezione (o di tutto il suono)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE767;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Volume…" /></StackPanel>
                        </Button>
                        <Button Command="{Binding NormalizeCommand}" Style="{StaticResource ToolButton}" ToolTip="Porta il volume al massimo possibile senza distorcere">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE9E9;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Normalizza" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Text="Voce (sulla selezione, o su tutto)" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding IsolateVoiceCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Tiene solo la voce e cancella musica, effetti e rumori sotto, con un modello di intelligenza artificiale che lavora sul tuo PC. Ideale per audio presi da film e video.">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE720;" Foreground="{StaticResource AccentBrush}" /><TextBlock Style="{StaticResource ToolLabel}" Text="Isola voce" /></StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveVoiceCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Il contrario: toglie la voce e lascia musica ed effetti (base karaoke, sottofondo di una scena)">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xEC54;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Togli voce" /></StackPanel>
                        </Button>
                        <Button Command="{Binding QuickVoiceCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Filtro rapido, senza intelligenza artificiale: tiene il centro dello stereo e la banda della voce. Istantaneo, ma la musica al centro resta.">
                            <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71C;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Filtro rapido" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Save -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" IsEnabled="{Binding IsReady}">
            <Button DockPanel.Dock="Right" Content="Chiudi" Click="Close_Click" MinWidth="80" />
            <Button DockPanel.Dock="Right" Content="Sostituisci l'originale" Command="{Binding ReplaceOriginalCommand}" Margin="0,0,8,0"
                    ToolTip="Salva sopra il file del suono: nella libreria, nei preferiti e sui tasti rapidi resta lo stesso suono" />
            <Button DockPanel.Dock="Right" Content="Salva come nuovo suono" Command="{Binding SaveAsNewCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                    ToolTip="Aggiunge alla libreria una copia modificata, nelle stesse categorie; l'originale resta com'è" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" Width="120" />
                <TextBlock Text="Qualità" VerticalAlignment="Center" Margin="12,0,6,0"
                           Visibility="{Binding IsLossy, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" ItemStringFormat="{}{0} kbps" Width="96"
                          Visibility="{Binding IsLossy, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Più è alta, più il suono è fedele e il file grande. 192 kbps va bene quasi sempre." />
                <TextBlock Text="Nome della copia" VerticalAlignment="Center" Margin="12,0,6,0" />
            </StackPanel>
            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalAlignment="Center"
                     ToolTip="Il nome del nuovo suono, con &quot;Salva come nuovo suono&quot;" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="2,8,0,0" ToolTip="{Binding StatusText}" />

        <!-- Selection and zoom -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="{Binding IsReady}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Allontana (Ctrl+rotella)" />
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Avvicina (Ctrl+rotella)" />
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE8B3;" Click="ZoomSelection_Click" ToolTip="Ingrandisci la selezione" />
                <Button Style="{StaticResource SmallIconButton}" Content="&#xE9A6;" Click="ZoomFit_Click" ToolTip="Mostra tutto il suono" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Inizio" VerticalAlignment="Center" />
                <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionStartText}" KeyDown="TimeBox_KeyDown"
                         ToolTip="Dove inizia la selezione (o il cursore): minuti:secondi, oppure solo i secondi" />
                <TextBlock Text="Fine" VerticalAlignment="Center" />
                <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionEndText}" KeyDown="TimeBox_KeyDown" />
                <TextBlock Text="Durata selezione" VerticalAlignment="Center" />
                <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectionLengthText}" KeyDown="TimeBox_KeyDown" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}">
                    <Run Text="Suono:" /> <Run Text="{Binding DurationText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding FormatText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Waveform -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:WaveformView x:Name="Wave" Audio="{Binding Clip}"
                                       SelectionStart="{Binding SelectionStart}" SelectionEnd="{Binding SelectionEnd}"
                                       Playhead="{Binding Playhead}" />
                <ScrollBar x:Name="WaveScroll" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed" Scroll="WaveScroll_Scroll" />

                <!-- Busy -->
                <Border Grid.RowSpan="2" Background="#C017171B" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,10">
                            <Run Text="{Binding BusyText, Mode=OneWay}" />
                            <Run Foreground="{StaticResource TextDimBrush}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="{Binding BusyProgress, Mode=OneWay, StringFormat={}{0:0}%}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusyCancellable}" Value="False">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <ProgressBar Height="6" Maximum="100" Value="{Binding BusyProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="IsIndeterminate" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusyCancellable}" Value="True">
                                            <Setter Property="IsIndeterminate" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Button Content="Annulla" Command="{Binding CancelBusyCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                Visibility="{Binding IsBusyCancellable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
