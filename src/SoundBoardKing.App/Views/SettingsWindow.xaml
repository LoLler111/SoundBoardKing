<Window x:Class="SoundBoardKing.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="Uscita audio (cuffie / casse)" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                  Margin="0,6,0,18" />

        <TextBlock Text="Microfono" FontWeight="SemiBold" />
        <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                   Text="Installa il modulo sul tuo microfono reale: nelle app (Discord, OBS…) continui a scegliere quello, e i suoni ci arrivano dentro. Richiede i permessi di amministratore e riavvia per un attimo l'audio di Windows." />
        <ComboBox ItemsSource="{Binding MicDevices}" SelectedItem="{Binding SelectedMicDevice}" DisplayMemberPath="Display" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Rimuovi" Command="{Binding UninstallMicCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Installa" Command="{Binding InstallMicCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
            <ComboBox ItemsSource="{Binding MicSlots}" SelectedItem="{Binding SelectedMicSlot}" DisplayMemberPath="Label"
                      ToolTip="Punto della catena audio in cui si inserisce il modulo. Cambialo solo se con quello consigliato il suono non arriva." />
        </DockPanel>
        <TextBox Text="{Binding MicLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,18"
                 MinHeight="44" MaxHeight="140" VerticalScrollBarVisibility="Auto" FontSize="12"
                 Foreground="{StaticResource TextDimBrush}" />

        <CheckBox Content="Permetti più suoni contemporaneamente" IsChecked="{Binding AllowOverlap}" Margin="0,0,0,10" />
        <CheckBox Content="Livella il volume dei suoni" IsChecked="{Binding LevelSounds}" />
        <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="22,2,0,18" FontSize="12"
                   Text="Porta tutti i suoni alla stessa intensità percepita (i file vengono analizzati una volta, in sottofondo) e impedisce che più suoni insieme distorcano, in cuffia e nel microfono." />

        <TextBlock Text="Tasti rapidi globali" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Ferma tutto" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StopHotkey, TargetNullValue=nessuno}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" />
            <Button Grid.Column="2" Content="Cambia…" Click="ChangeStop_Click" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Text="Pausa / riprendi" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PauseHotkey, TargetNullValue=nessuno}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Cambia…" Click="ChangePause_Click" />
        </Grid>

        <TextBlock Text="Profilo (libreria e impostazioni)" FontWeight="SemiBold" Margin="0,18,0,0" />
        <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                   Text="Un unico file con tutta la libreria, i preferiti e le impostazioni (tranne i dispositivi audio), aggiornato a ogni modifica. Copialo per portarti tutto su un altro PC; se lo tieni accanto all'eseguibile o in una cartella a fianco (es. App, Config e Suoni affiancate), viene ritrovato anche spostando tutto insieme, con i suoni vicini salvati in modo relativo." />
        <TextBox Text="{Binding ProfilePath, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
        <TextBlock Text="{Binding ProfileLocationText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                   Foreground="{StaticResource TextDimBrush}" />
        <WrapPanel Margin="0,8,0,0">
            <Button Content="Accanto all'eseguibile" Click="MoveNextToExe_Click" Margin="0,0,8,6"
                    IsEnabled="{Binding CanMoveNextToExecutable}"
                    ToolTip="{Binding ExecutableProfilePath}" />
            <Button Content="Sposta…" Click="MoveProfile_Click" Margin="0,0,8,6"
                    ToolTip="Sposta il profilo in un'altra cartella e continua a usarlo da lì" />
            <Button Content="Esporta una copia…" Click="ExportProfile_Click" Margin="0,0,8,6" />
            <Button Content="Apri profilo…" Click="OpenProfile_Click" Margin="0,0,8,6"
                    ToolTip="Usa un profilo esportato (l'app si riavvia)" />
            <Button Content="Mostra nella cartella" Click="ShowProfile_Click" Margin="0,0,0,6" />
        </WrapPanel>
        <TextBlock Text="{Binding ProfileLog}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDimBrush}" />

        <TextBlock FontWeight="SemiBold" Margin="0,18,0,0">
            <Run Text="Versione" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
        </TextBlock>
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Riavvia e aggiorna" Click="RestartToUpdate_Click" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="Cerca aggiornamenti" Command="{Binding CheckForUpdatesCommand}" />
            <TextBlock Text="{Binding UpdateLog}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
