<Window x:Class="SoundBoardKing.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One group of settings: a rounded panel with an icon and a title on top. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A named part inside a group. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
    </Window.Resources>
    <!-- Taller than some screens: the settings scroll, OK and Annulla always stay in view. -->
    <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
            <Button Content="Annulla" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,20,20,8">

        <!-- Audio -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE767;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Audio" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Uscita (cuffie / casse)" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" />
                <CheckBox Content="Livella il volume dei suoni" IsChecked="{Binding LevelSounds}" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="43,4,0,0"
                           Text="Porta tutti i suoni alla stessa intensità percepita (i file vengono analizzati una volta, in sottofondo) e impedisce che più suoni insieme distorcano, in cuffia e nel microfono." />
            </StackPanel>
        </Border>

        <!-- Microphone module -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE720;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Microfono" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Installa il modulo sul tuo microfono reale: nelle app (Discord, OBS…) continui a scegliere quello, e i suoni ci arrivano dentro. Richiede i permessi di amministratore e riavvia per un attimo l'audio di Windows." />
                <ComboBox ItemsSource="{Binding MicDevices}" SelectedItem="{Binding SelectedMicDevice}" DisplayMemberPath="Display" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Rimuovi" Command="{Binding UninstallMicCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Installa" Command="{Binding InstallMicCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding MicSlots}" SelectedItem="{Binding SelectedMicSlot}" DisplayMemberPath="Label"
                              ToolTip="Punto della catena audio in cui si inserisce il modulo. Cambialo solo se con quello consigliato il suono non arriva." />
                </DockPanel>
                <TextBox Text="{Binding MicLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                         MinHeight="44" MaxHeight="140" VerticalScrollBarVisibility="Auto" FontSize="12"
                         Foreground="{StaticResource TextDimBrush}" />
            </StackPanel>
        </Border>

        <!-- Global hotkeys -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE765;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Tasti rapidi globali" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ferma tutto" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StopHotkey, TargetNullValue=nessuno}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" />
                    <Button Grid.Column="2" Content="Cambia…" Click="ChangeStop_Click" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Text="Pausa / riprendi" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PauseHotkey, TargetNullValue=nessuno}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Cambia…" Click="ChangePause_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Library: where the sound files live, and where they can come from -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8B7;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Libreria" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Cartella dei suoni" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="La cartella con tutti i file audio, accanto all'app (es. ..\Suoni) o altrove, anche su un NAS (es. \\NAS\Suoni). All'avvio, e con il pulsante accanto a CATEGORIE, i file nuovi entrano nella libreria in &quot;Senza categoria&quot;; i suoni aggiunti da fuori e quelli di Myinstants vengono copiati qui." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="BrowseSoundsFolder_Click" Margin="8,0,0,0" />
                    <TextBox Text="{Binding SoundsFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                </DockPanel>
                <CheckBox Content="Relativo alla cartella dell'app (si sposta insieme all'app)" IsChecked="{Binding IsSoundsFolderRelative}"
                          IsEnabled="{Binding CanSoundsFolderBeRelative}" Margin="0,10,0,0" ToolTip="{Binding AppFolder}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding SoundsFolderInfo}" Margin="0,6,0,0" />

                <Border Style="{StaticResource Divider}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="ImportSpl_Click" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B5;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Importa…" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Importa da SoundPad" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Sostituisce la libreria con suoni, categorie e preferiti di un file .spl di SoundPad. Le impostazioni cambiate qui vengono confermate prima." />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Profile -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE77B;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Profilo" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Un unico file con tutta la libreria, i preferiti e le impostazioni (tranne i dispositivi audio), aggiornato a ogni modifica. Copialo per portarti tutto su un altro PC; se lo tieni accanto all'eseguibile o in una cartella a fianco (es. App, Config e Suoni affiancate), viene ritrovato anche spostando tutto insieme, con i suoni vicini salvati in modo relativo." />
                <TextBox Text="{Binding ProfilePath, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding ProfileLocationText}" Margin="0,4,0,0" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Accanto all'eseguibile" Click="MoveNextToExe_Click" Margin="0,0,8,6"
                            IsEnabled="{Binding CanMoveNextToExecutable}"
                            ToolTip="{Binding ExecutableProfilePath}" />
                    <Button Content="Sposta…" Click="MoveProfile_Click" Margin="0,0,8,6"
                            ToolTip="Sposta il profilo in un'altra cartella e continua a usarlo da lì" />
                    <Button Content="Esporta una copia…" Click="ExportProfile_Click" Margin="0,0,8,6" />
                    <Button Content="Apri profilo…" Click="OpenProfile_Click" Margin="0,0,8,6"
                            ToolTip="Usa un profilo esportato (l'app si riavvia)" />
                    <Button Content="Mostra nella cartella" Click="ShowProfile_Click" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding ProfileLog}" />
            </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE895;" />
                    <TextBlock Style="{StaticResource CardTitle}">
                        <Run Text="Aggiornamenti" /><Run Text=" · versione " Foreground="{StaticResource TextDimBrush}" FontWeight="Normal" /><Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Riavvia e aggiorna" Click="RestartToUpdate_Click" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}"
                            Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Content="Cerca aggiornamenti" Command="{Binding CheckForUpdatesCommand}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateLog}" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
